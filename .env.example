# LLM provider:
#   "openrouter" (free Nemotron + cheap Qwen fallback, key from https://openrouter.ai/keys)
#   "gemini"     (free tier, key from https://aistudio.google.com/apikey)
#   "openai"     (paid API credits from platform.openai.com)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Embeddings: "pinecone" (free llama-text-embed-v2, uses PINECONE_API_KEY), "gemini" or "openai".
# Defaults to pinecone for openrouter, otherwise the LLM provider.
# EMBEDDING_PROVIDER=

# Optional model overrides (comma-separated fallback list, max 3). Model ids change often: pick ids
# from https://openrouter.ai/models
# CHAT_MODEL=
# UTILITY_MODEL=
# OCR_MODEL=         (must accept images; reads scanned PDF pages, one call per page)
# EMBEDDING_MODEL=

# Each answer is checked claim-by-claim against its sources with one extra LLM call.
# Set to false to save free-tier quota.
# VERIFY_ANSWERS=true

# Pinecone (free Starter plan). Index dimension must match the embedding model:
# llama-text-embed-v2 (pinecone) -> 1024, gemini-embedding-001 -> 3072,
# text-embedding-3-small -> 1536. Metric: cosine, vector type: dense.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ragstack-free

# Supabase (free plan): Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Which build stage the app shows, so each project review can reveal the next milestone
# (restart the dev server after changing it):
#   1 = ingestion + knowledge base + plain semantic chat
#   2 = + filters, hybrid keyword search, reranking, year detection, retrieval trace
#   3 = + inline citations, claim check, Evaluation page (default: everything)
# NEXT_PUBLIC_DEMO_STAGE=3
