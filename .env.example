# LLM provider: "gemini" (free tier, key from https://aistudio.google.com/apikey)
#            or "openai" (paid API credits from platform.openai.com; ChatGPT plans don't include API access)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults: gemini-2.5-flash / gemini-2.5-flash-lite / gemini-embedding-001,
# or gpt-4o-mini / gpt-4o-mini / text-embedding-3-small)
# CHAT_MODEL=
# UTILITY_MODEL=
# EMBEDDING_MODEL=

# Pinecone (free Starter plan). Index dimension must match the embedding model:
# gemini-embedding-001 -> 3072, text-embedding-3-small -> 1536. Metric: cosine.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ragstack

# Supabase (free plan): Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
